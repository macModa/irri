# Configuration pour Docker Compose
# Copiez ce fichier et modifiez les valeurs selon vos besoins

# OpenWeather API Key (obligatoire)
# Obtenez votre clé sur: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Django Secret Key (changez en production)
SECRET_KEY=django-insecure-change-this-in-production

# Mode Debug (False en production)
DEBUG=True

# Hosts autorisés
ALLOWED_HOSTS=localhost,127.0.0.1,backend
